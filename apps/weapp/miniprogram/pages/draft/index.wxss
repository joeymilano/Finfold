.draft-eyebrow {
  margin: 0 0 20rpx;
}
.draft-eyebrow-gap {
  margin: 32rpx 0 20rpx;
}
.draft-fact {
  margin-top: 20rpx;
  min-height: 110rpx;
}
.draft-generate {
  margin-top: 36rpx;
}
.draft-credits {
  text-align: center;
  margin-top: 18rpx;
}
.draft-waiting {
  margin-top: 20rpx;
  font-size: 25rpx;
}
.result-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
  gap: 16rpx;
}
.result-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--fg);
}
.result-body {
  max-height: 640rpx;
  font-size: 27rpx;
  line-height: 1.85;
  white-space: pre-wrap;
  color: var(--body-c);
  margin-bottom: 36rpx;
}
.draft-error {
  color: #FB6E85;
}
.history-card {
  padding-top: 12rpx;
  padding-bottom: 16rpx;
}
.history {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 26rpx 0;
  border-bottom: 1rpx solid var(--hairline);
}
.history:last-child {
  border-bottom: none;
}
.history-title {
  flex: 1;
  font-size: 27rpx;
  color: var(--fg);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
