# Finfold 国内站（www.finfold.cn）环境变量模板
# ---------------------------------------------------------------
# 用法：cp .env.cn.example .env.cn && 填值。
# 构建（NEXT_PUBLIC_* 与所有客户端内联变量在 build 时固化）：
#   set -a; . ./.env.cn; set +a; npm run build
# 运行：systemd 从同一份 .env.cn 注入 Web 与 scheduler 两个进程。
#
# 与全球站（www.finfold.app，Cloudflare）共用同一个 Supabase 项目与
# 数据库：SUPABASE_* 与 INTEGRATION_ENCRYPTION_KEY 必须与 Cloudflare
# 侧一致；仅用于内部回环鉴权的 GENERATION_WORKER_SECRET 可独立取值。

# ---- 站点标识（CN 专属）------------------------------------------------
NEXT_PUBLIC_APP_URL=https://www.finfold.cn
FINFOLD_MCP_RESOURCE_URL=https://www.finfold.cn/mcp
FINFOLD_DEPLOYMENT_ENV=production
# ICP 备案号（备案通过后填，格式如 京ICP备2026XXXXXX号；页脚/登录页/控制台展示）
NEXT_PUBLIC_ICP_BEIAN_NUMBER=
# 公安备案号（公安备案完成后填，如 京公网安备11010502012345号；可为空）
NEXT_PUBLIC_GONGAN_BEIAN_NUMBER=

# ---- Supabase（与全球站共用，值相同）------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ---- 内部执行链路（CN 独立取值即可）--------------------------------------
# scheduler.mjs 与 Next 进程间回环调用的共享密钥：openssl rand -hex 32
GENERATION_WORKER_SECRET=
# watch-poller 系列定时任务（趋势同步/表现轮询/Agent 巡逻）的 Bearer 密钥；
# 可与 Cloudflare 侧一致或独立取值（只校验本机 .env.cn 内的自洽性）。
CRON_WATCH_SECRET=
CRON_PERF_SECRET=
# 自部署调度守护进程的回环地址与并发
FINFOLD_INTERNAL_ORIGIN=http://127.0.0.1:3000
GENERATION_CONCURRENCY=3
# 队列模式：任务落 Supabase outbox，由 finfold-scheduler 服务执行
GENERATION_EXECUTION_MODE=queue
GENERATION_QUEUE_NAME=finfold-generation-jobs
GENERATION_DLQ_NAME=finfold-generation-jobs-dlq

# ---- 加密与安全 ---------------------------------------------------------
# 必须与 Cloudflare 侧一致：数据库中已加密的社媒平台令牌用它解密。
INTEGRATION_ENCRYPTION_KEY=
# 为 www.finfold.cn 域名单独创建的 Turnstile widget（Cloudflare 控制台，
# 免费）：新 widget 的 site key + secret。全球站的 widget 域名不含 .cn。
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ---- 埋点 ---------------------------------------------------------------
# 留空即关闭 PostHog（us.i.posthog.com 大陆访问不稳定，且无国内节点）。
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=

# ---- LLM / 图片（与全球站相同即可；供应商本就在国内）-----------------------
ZHIPU_ENABLED=true
ZHIPU_API_MODE=coding-plan
ZHIPU_API_BASE=https://open.bigmodel.cn/api/coding/paas/v4
ZHIPU_MODEL=glm-5.3-flash
ZHIPU_MODEL_STRONG=glm-5.3
ZHIPU_VISION_MODEL=glm-5.3-flash
ZHIPU_PRIORITY_EXPIRES_AT=2026-10-07T00:00:00+08:00
ZHIPU_API_KEY=
DASHSCOPE_FREE_API_KEY=
DASHSCOPE_API_KEY=
DEEPSEEK_API_KEY=
LETTA_API_URL=https://api.letta.com
LETTA_API_KEY=
LETTA_MODEL=letta/auto
LETTA_GENERATION_MODEL=letta/auto
LETTA_EMBEDDING=openai/text-embedding-3-small
LLM_PROVIDERS=[{"name":"qwen-free-latest","base":"https://dashscope.aliyuncs.com/compatible-mode/v1","keyEnv":"DASHSCOPE_FREE_API_KEY","models":{"haiku":"qwen3.8-flash","sonnet":"qwen3.8-flash","opus":"qwen3.8-flash","vision":"qwen3.8-flash"},"supportsVideo":true,"enableThinking":false,"jsonMode":"object"},{"name":"qwen-free-snapshot","base":"https://dashscope.aliyuncs.com/compatible-mode/v1","keyEnv":"DASHSCOPE_FREE_API_KEY","models":{"haiku":"qwen3.7-flash-2026-07-15","sonnet":"qwen3.7-flash-2026-07-15","opus":"qwen3.7-flash-2026-07-15","vision":"qwen3.7-flash-2026-07-15"},"supportsVideo":true,"enableThinking":false,"jsonMode":"object"},{"name":"deepseek","base":"https://api.deepseek.com","keyEnv":"DEEPSEEK_API_KEY","models":{"haiku":"deepseek-v4-flash","sonnet":"deepseek-v4-pro","opus":"deepseek-v4-pro"},"jsonMode":"object"},{"name":"qwen-token-plan","base":"https://your-dashscope-workspace.example.com/compatible-mode/v1","keyEnv":"DASHSCOPE_API_KEY","models":{"haiku":"qwen3.8-flash","sonnet":"qwen3.8-flash","opus":"qwen3.8-flash","vision":"qwen3.8-flash"},"supportsVideo":true,"enableThinking":false,"jsonMode":"object","monthlyBudgetCny":10}]
IMAGE_DASHSCOPE_API_BASE=https://your-dashscope-workspace.example.com
IMAGE_DASHSCOPE_QWEN_PRO_MODEL=qwen-image-3.0-pro
IMAGE_DASHSCOPE_QWEN_MODEL=qwen-image-3.0
IMAGE_DASHSCOPE_WAN_PRO_MODEL=wan2.7-image-pro
IMAGE_DASHSCOPE_MODEL=wan2.7-image
IMAGE_DASHSCOPE_FREE_API_BASE=https://dashscope.aliyuncs.com
IMAGE_DASHSCOPE_FREE_PRO_MODEL=qwen-image-3.0-pro
IMAGE_DASHSCOPE_FREE_MODEL=qwen-image-3.0
IMAGE_DASHSCOPE_THINKING=true
IMAGE_API_BASE=https://apihub.agnes-ai.com
IMAGE_API_KEY=
IMAGE_MODEL=agnes-image-2.1-flash
# Workers AI（FLUX 图像）经 api.cloudflare.com 调用，大陆直连可用性一般；
# 主图片链路已是 DashScope，这里保留为可选兜底。
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_AI_TOKEN=
IMAGE_WORKERS_AI_COVER_MODEL=@cf/black-forest-labs/flux-2-klein-9b
IMAGE_WORKERS_AI_MODEL=@cf/black-forest-labs/flux-2-klein-4b
WORKERS_AI_DAILY_NEURON_BUDGET=9000

# ---- 业务开关（与全球站保持同步）-----------------------------------------
SIGNAL_DISCOVERY_ENABLED=true
SIGNAL_DISCOVERY_PROVIDER_NAMES=qwen-free-latest,qwen-free-snapshot
FINFOLD_GROWTH_LOOP_ENABLED=true
FINFOLD_GROWTH_LOOP_PILOT_MODE=whitelist
FINFOLD_GROWTH_LOOP_PILOT_USER_IDS=
FINFOLD_EXTENSION_REPLY_DRAFTS_ENABLED=true
FINFOLD_EXTENSION_REPLY_PILOT_MODE=open
FINFOLD_EXTENSION_REPLY_DAILY_LIMIT=30
FINFOLD_EXTENSION_REPLY_PILOT_USER_IDS=
FINFOLD_EXTENSION_AUTH_ENABLED=true
FINFOLD_EXTENSION_PAID_ACTIONS_ENABLED=true
FINFOLD_EXTENSION_ANONYMOUS_ENABLED=false
FINFOLD_EXTENSION_ANONYMOUS_DAILY_LIMIT=10
FINFOLD_EXTENSION_ANONYMOUS_IP_ATTEMPTS=3
FINFOLD_EXTENSION_ORIGINS=chrome-extension://gebbcemokglolnbocggbefmkjkfkcfhe,chrome-extension://lgkoejhkpfpbpebdlbgojngohgghmgpg
AGENT_SUBAGENTS_ENABLED=true
X_OAUTH_ENABLED=true
X_PIPELINE_ENABLED=true
# 首条审核通过的 X 帖子 live 验证前保持 false（与全球站策略一致）
X_PUBLISHING_ENABLED=false
# Jev 决策层（jev_guarded 审核模式 + 回复分诊）。api.typesafe.ai 国内
# 可达性未验证，国内站保持关闭；关闭时 jev_guarded 自动回落逐条人工审核。
JEV_ENABLED=false
JEV_API_KEY=
X_OAUTH_CLIENT_ID=
X_OAUTH_CLIENT_SECRET=
WECHAT_COMPONENT_ENABLED=false
WECHAT_DRAFT_PUBLISHING_ENABLED=false
WECHAT_FORMAL_PUBLISHING_ENABLED=false
WECHAT_COMPONENT_APP_ID=
WECHAT_COMPONENT_APP_SECRET=
WECHAT_COMPONENT_TOKEN=
WECHAT_COMPONENT_ENCODING_AES_KEY=

