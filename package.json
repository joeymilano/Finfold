{
  "name": "finfold",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/dev-server.mjs",
    "brand:favicons": "node scripts/generate-favicons.mjs",
    "icons:check": "node scripts/check-fontawesome-resilience.mjs",
    "icons:fallbacks": "node scripts/generate-lucide-fallbacks.mjs",
    "icons:snapshot": "node scripts/snapshot-fontawesome-icons.mjs",
    "build": "next build",
    "build:cf": "node scripts/build-cloudflare.mjs",
    "build:cf:staging": "node scripts/build-staging.mjs",
    "preview": "npm run build:cf && opennextjs-cloudflare preview",
    "deploy": "npm run security:check && npm run build:cf && opennextjs-cloudflare deploy",
    "postdeploy": "node scripts/cloudflare-security-check.mjs --main --deployed",
    "deploy:staging": "npm run security:check:cloudflare:staging && npm run build:cf:staging && wrangler deploy --config wrangler.staging.toml",
    "postdeploy:staging": "node scripts/cloudflare-security-check.mjs --staging --deployed",
    "plugin:check": "node scripts/check-chatgpt-plugin.mjs",
    "predeploy:poller": "npm run security:check:cloudflare",
    "deploy:poller": "wrangler deploy --config workers/watch-poller/wrangler.toml",
    "postdeploy:poller": "node scripts/cloudflare-security-check.mjs --poller --deployed",
    "cf:typegen": "wrangler types --env-interface CloudflareEnv --include-runtime=false --strict-vars=false cloudflare-env.d.ts",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "e2e": "playwright test --project=smoke-chromium",
    "e2e:staging": "node scripts/run-staging-e2e.mjs",
    "e2e:install": "playwright install chromium",
    "security:check": "npm run security:check:local && npm run security:check:cloudflare",
    "security:check:local": "node scripts/security-readiness.mjs",
    "security:check:cloudflare": "node scripts/cloudflare-security-check.mjs",
    "security:check:cloudflare:staging": "node scripts/cloudflare-security-check.mjs --staging",
    "security:check:cloudflare:deployed": "node scripts/cloudflare-security-check.mjs --deployed",
    "db:check": "node scripts/check-db-migrations.mjs",
    "db:check:staging": "node scripts/check-db-migrations.mjs --staging",
    "db:contract:sql": "node scripts/check-db-contract.mjs",
    "db:contract:summary": "node scripts/check-db-contract.mjs --summary",
    "cost:check": "node scripts/check-zero-cost-upgrade.mjs",
    "worker:size": "node scripts/check-worker-size.mjs",
    "audit:prod": "npm audit --omit=dev --audit-level=high",
    "seo:indexnow": "node scripts/submit-indexnow.mjs",
    "seo:baidu": "node scripts/submit-baidu.mjs",
    "ci:verify": "npm run icons:check && npm run lint && npm run typecheck && npm test && npm run cost:check && npm run build:cf && npm run worker:size && npm run audit:prod",
    "release": "./scripts/release.sh",
    "extension:verify": "npm --prefix apps/chrome-extension test && npm --prefix apps/chrome-extension run package",
    "extension:publish-zip": "npm run extension:verify && mkdir -p public/downloads && cp apps/chrome-extension/release/*.zip public/downloads/"
  },
  "dependencies": {
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource/noto-serif-sc": "^5.3.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@paper-design/shaders-react": "^0.0.77",
    "@supabase/ssr": "^0.12.5",
    "@supabase/supabase-js": "^2.115.0",
    "fflate": "^0.8.3",
    "geist": "^1.7.2",
    "jose": "^6.2.10",
    "jsqr": "^1.4.0",
    "lottie-react": "^2.4.1",
    "lucide-react": "0.468.0",
    "modern-screenshot": "^4.7.0",
    "motion": "^12.40.0",
    "next": "^15.5.22",
    "posthog-js": "^1.203.1",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "read-excel-file": "^9.3.5",
    "reicon-react": "^1.1.0",
    "remark-gfm": "^4.0.1",
    "unpdf": "^1.8.1",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.20.2",
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^22.10.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.17.0",
    "eslint-config-next": "^15.5.22",
    "jsdom": "^25.0.1",
    "postcss": "^8.4.49",
    "rclone.js": "^0.6.6",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "vitest": "^3.2.6",
    "wrangler": "^4.115.0"
  },
  "overrides": {
    "next": {
      "postcss": "8.5.25",
      "sharp": "0.35.4"
    },
    "nanoid": "3.3.18",
    "posthog-js": {
      "dompurify": "3.4.13"
    }
  }
}
