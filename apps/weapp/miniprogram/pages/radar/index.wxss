/* 首次画像引导 */
.onboard-title {
  font-size: 34rpx;
  font-weight: 700;
  margin-bottom: 10rpx;
}
.onboard-sub {
  font-size: 25rpx;
}
.onboard-input {
  margin-top: 22rpx;
}
.onboard-eyebrow {
  margin: 32rpx 0 20rpx;
}
.onboard-go {
  margin-top: 36rpx;
}

/* 窗口切换：编辑型下划线 */
.window-row {
  display: flex;
  gap: 48rpx;
  padding-top: 4rpx;
}
.window-item {
  position: relative;
  padding: 16rpx 0 20rpx;
  color: var(--label);
  font-size: 27rpx;
}
.window-active {
  color: var(--gold);
  font-weight: 600;
}
.window-active::after {
  content: "";
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  height: 4rpx;
  border-radius: 4rpx;
  background: linear-gradient(90deg, var(--gold), rgba(217, 164, 65, 0.25));
}
.feed-meta {
  margin: 8rpx 0 28rpx;
}

/* 机会卡：左侧信息 + 右侧衬线分数列 */
.opp {
  display: flex;
  gap: 32rpx;
  padding: 32rpx 36rpx;
}
.opp-main {
  flex: 1;
  min-width: 0;
}
.opp-head {
  display: flex;
  align-items: center;
  gap: 14rpx;
  margin-bottom: 18rpx;
}
.opp-time {
  margin-left: auto;
  color: var(--label);
  font-size: 21rpx;
  letter-spacing: 0.03em;
}
.opp-title {
  font-size: 32rpx;
  font-weight: 600;
  line-height: 1.5;
  color: var(--fg);
  letter-spacing: 0.01em;
}
.opp-why {
  margin-top: 14rpx;
  font-size: 25rpx;
  line-height: 1.65;
  color: var(--body-c);
  opacity: 0.92;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}
.opp-foot {
  display: flex;
  align-items: center;
  margin-top: 28rpx;
  padding-top: 22rpx;
  border-top: 1rpx solid var(--hairline);
}
.opp-foot .faint {
  flex: 1;
}
.score-col {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding-left: 32rpx;
  border-left: 1rpx solid var(--hairline);
  min-width: 112rpx;
}
.score-num {
  font-size: 60rpx;
  font-weight: 600;
  color: var(--gold);
  line-height: 1;
  letter-spacing: 0.02em;
}
.score-label {
  margin-top: 12rpx;
  font-size: 19rpx;
  letter-spacing: 0.2em;
  color: var(--label);
  padding-left: 0.2em;
}
.empty-mark {
  font-size: 72rpx;
  color: var(--gold-dim);
  margin-bottom: 20rpx;
}
