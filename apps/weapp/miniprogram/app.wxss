/**
 * 增长搭子 — 全局设计系统「编辑部暗房」
 * 暖近黑纸面 + 衬线大数字 + 单一金色焦点。
 * 延展自主站「The Studio Floor」：金色只做锚点，青色只做 AI 语义。
 */
page {
  --bg: #0B0A08;
  --surface: #14120E;
  --surface-2: #1B1813;
  --hairline: rgba(255, 255, 255, 0.055);
  --hairline-strong: rgba(255, 255, 255, 0.12);
  --fg: #F2EEE5;
  --body-c: #C9C2B4;
  --label: #8A8375;
  --gold: #D9A441;
  --gold-dim: #B98A34;
  --gold-bright: #E8B84B;
  --ink: #171208;
  --ai: #6FCFC2;
  --ai-line: rgba(45, 212, 191, 0.32);
  --ai-bg: rgba(45, 212, 191, 0.06);
  --radius: 28rpx;

  background: var(--bg);
  background-image: radial-gradient(120% 30% at 50% -6%, rgba(217, 164, 65, 0.075), transparent 60%);
  color: var(--fg);
  font-size: 28rpx;
  line-height: 1.6;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Segoe UI", sans-serif;
}

.font-display {
  font-family: Georgia, "Songti SC", "STSong", "Noto Serif SC", serif;
}

/* ============ 版式 ============ */
.page-pad {
  padding: 16rpx 40rpx 72rpx;
}
.eyebrow {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin: 52rpx 0 24rpx;
  font-size: 22rpx;
  letter-spacing: 0.14em;
  color: var(--label);
}
.eyebrow-num {
  font-family: Georgia, "Songti SC", "STSong", serif;
  font-size: 23rpx;
  color: var(--gold-dim);
  letter-spacing: 0.08em;
}
.eyebrow-line {
  flex: 1;
  height: 1rpx;
  background: var(--hairline);
}
.body-text {
  color: var(--body-c);
  font-size: 27rpx;
  line-height: 1.75;
}
.faint {
  color: var(--label);
  font-size: 23rpx;
  letter-spacing: 0.02em;
}

/* ============ 卡片：分层表面 + 内高光 ============ */
.card {
  background: var(--surface);
  border: 1rpx solid var(--hairline);
  border-radius: var(--radius);
  padding: 36rpx;
  margin-bottom: 28rpx;
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.035), 0 36rpx 80rpx -56rpx rgba(0, 0, 0, 0.85);
}
.card-raised {
  background: var(--surface-2);
}

/* ============ 徽章：描边胶囊 + 状态色点（全站唯一形态） ============ */
.badge {
  display: inline-flex;
  align-items: center;
  gap: 10rpx;
  font-size: 21rpx;
  letter-spacing: 0.06em;
  padding: 6rpx 18rpx 6rpx 14rpx;
  border-radius: 999rpx;
  border: 1rpx solid var(--hairline-strong);
  color: var(--body-c);
}
.badge-dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 999rpx;
}
.dot-rising { background: var(--gold); }
.dot-hot { background: var(--gold-bright); }
.dot-new { background: #55C9B9; }
.dot-cool { background: #6E675B; }
.badge-best {
  border-color: rgba(217, 164, 65, 0.5);
  color: var(--gold);
  background: rgba(217, 164, 65, 0.08);
  letter-spacing: 0.1em;
}

/* ============ 按钮：每页至多一个金色主操作 ============ */
.btn {
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 20rpx;
  font-size: 28rpx;
  padding: 24rpx 36rpx;
  border: 1rpx solid var(--hairline-strong);
  color: var(--fg);
  background: transparent;
}
.btn::after {
  border: none;
}
.btn-primary {
  background: var(--gold);
  color: var(--ink);
  font-weight: 600;
  border: none;
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.28), 0 20rpx 52rpx -28rpx rgba(217, 164, 65, 0.55);
}
.btn-disabled {
  opacity: 0.45;
  pointer-events: none;
}
.btn-row {
  display: flex;
  gap: 24rpx;
  margin-top: 36rpx;
}
.btn-row .btn {
  flex: 1;
}
.cta-gold {
  color: var(--gold);
  font-size: 25rpx;
  font-weight: 600;
  letter-spacing: 0.04em;
}

/* ============ 表单 ============ */
.input,
.textarea {
  background: rgba(255, 255, 255, 0.035);
  border: 1rpx solid var(--hairline);
  border-radius: 20rpx;
  color: var(--fg);
  padding: 24rpx 28rpx;
  font-size: 28rpx;
  width: 100%;
  box-sizing: border-box;
}
.textarea {
  min-height: 144rpx;
}
.ph {
  color: var(--label);
}
.chip-row {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}
.chip {
  padding: 14rpx 32rpx;
  border-radius: 999rpx;
  border: 1rpx solid var(--hairline-strong);
  color: var(--body-c);
  font-size: 25rpx;
}
.chip-active {
  color: var(--ink);
  background: var(--gold);
  border-color: transparent;
  font-weight: 600;
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.25);
}

/* ============ AI 语义标识（唯一允许的冷色） ============ */
.ai-badge {
  display: inline-flex;
  align-items: center;
  gap: 10rpx;
  font-size: 21rpx;
  letter-spacing: 0.05em;
  color: var(--ai);
  border: 1rpx solid var(--ai-line);
  background: var(--ai-bg);
  border-radius: 999rpx;
  padding: 6rpx 18rpx;
}

/* ============ 其他 ============ */
.empty {
  text-align: center;
  color: var(--label);
  padding: 96rpx 48rpx;
  font-size: 26rpx;
  line-height: 1.8;
}
.divider {
  height: 1rpx;
  background: var(--hairline);
  margin: 24rpx 0;
}
.colophon {
  display: flex;
  align-items: center;
  gap: 24rpx;
  text-align: center;
  color: var(--label);
  font-size: 22rpx;
  letter-spacing: 0.12em;
  padding: 44rpx 0 16rpx;
}
.colophon::before,
.colophon::after {
  content: "";
  flex: 1;
  height: 1rpx;
  background: var(--hairline);
}
.skeleton {
  background: linear-gradient(90deg, var(--surface) 25%, var(--surface-2) 50%, var(--surface) 75%);
  background-size: 200% 100%;
  animation: shimmer 1.4s infinite;
  border-radius: var(--radius);
  height: 200rpx;
  margin-bottom: 28rpx;
}
@keyframes shimmer {
  0% { background-position: 200% 0; }
  100% { background-position: -200% 0; }
}
