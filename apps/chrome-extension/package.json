{
  "name": "@finfold/chrome-extension",
  "version": "1.1.4",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "package": "npm run build && node scripts/package.mjs && node scripts/audit-package.mjs",
    "audit:zip": "node scripts/audit-package.mjs",
    "prebuild": "node scripts/sync-design.mjs",
    "predev": "node scripts/sync-design.mjs",
    "package:store": "VITE_STORE_BUILD=1 npm run package"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.326",
    "@types/node": "^22.10.5",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^4.7.0",
    "fflate": "^0.8.3",
    "jsdom": "^25.0.1",
    "sharp": "^0.35.3",
    "typescript": "^5.7.2",
    "vite": "^6.4.1",
    "vitest": "^3.2.6"
  }
}
